MERGE (n:regulation {id: 'doc:CCAR-33-R2'}) ON CREATE SET n.label = 'CCAR-33-R2', n.title = '航空发动机适航规定', n.text = 'CCAR-33-R2 航空发动机适航规定', n.section_number = '', n.source = 'CCAR-33-R2', n.authority = 'CAAC', n.depth = 0;
MERGE (n:section {id: 'ccar33:0000'}) ON CREATE SET n.label = 'A章 总    则', n.title = 'A章 总    则', n.text = '', n.section_number = '', n.source = 'CCAR-33-R2', n.authority = 'CAAC', n.depth = 1;
MERGE (n:section {id: 'ccar33:0001'}) ON CREATE SET n.label = '第33.1条 适用范围', n.title = '第33.1条 适用范围', n.text = '（a）本规定规定颁发和更改航空发动机型号合格证用的适航标准。\n\n（b）按照中国民用航空规章《民用航空产品和零部件合格审定规定》（CCAR-21）的规定申请航空发动机型号合格证或申请对该合格证进行更改的法人，必须表明符合本规定中适用的要求，并且必须表明符合中国民用航空规章《涡轮发动机飞机燃油排泄和排气排出物规定》（CCAR-34）。\n\n［2002年4月19日第一次修订］', n.section_number = '33.1', n.source = 'CCAR-33-R2', n.authority = 'CAAC', n.depth = 2;
MERGE (n:section {id: 'ccar33:0002'}) ON CREATE SET n.label = '第33.3条 概述', n.title = '第33.3条 概述', n.text = '每一个申请人必须表明该型航空发动机符合本规定中适用的要求。', n.section_number = '33.3', n.source = 'CCAR-33-R2', n.authority = 'CAAC', n.depth = 2;
MERGE (n:section {id: 'ccar33:0003'}) ON CREATE SET n.label = '第33.4条 持续适航文件 申请人必须根据本规定附件 A 编制中国民用航空局可接受的', n.title = '第33.4条 持续适航文件 申请人必须根据本规定附件 A 编制中国民用航空局可接受的', n.text = '申请人必须根据本规定附件A编制中国民用航空局可接受的持续适航文件。如果有计划保证在交付第一架装有该发动机的航空器之前或者在为装有该发动机的航空器颁发适航证之前完成这些文件，则这些文件在型号合格审定时可以是不完备的。', n.section_number = '33.4', n.source = 'CCAR-33-R2', n.authority = 'CAAC', n.depth = 2;
MERGE (n:section {id: 'ccar33:0004'}) ON CREATE SET n.label = '第33.5条 发动机安装和使用说明手册', n.title = '第33.5条 发动机安装和使用说明手册', n.text = '每一个申请人必须备有在型号合格证颁发之前可供中国民用航空局应用，在发动机交付时可供用户使用的经批准的发动机安装和使用说明手册。该说明手册必须至少包括下列内容：\n\n**（a）安装说明**\n\n1. 发动机安装构件的位置，将发动机装接到航空器上的方法及安装构件和相关结构的最大允许载荷；\n2. 发动机与附件、管件、导线和电缆、钢索、导管及整流罩连接的位置和说明；\n3. 包括总体尺寸的发动机轮廓图；\n4. 定义发动机与航空器和航空器设备，包括螺旋桨（如适用）的物理和功能界面；\n5. 如果发动机系统所依靠的部件不是发动机型号设计的组成部分，而发动机型号合格审定又要基于这些部件，则其界面条件和可靠性要求必须在发动机安装说明手册中直接规定，或者规定参考适当的文件；\n6. 必须给出发动机控制所需的仪表清单，包括控制发动机工作的仪表精度和瞬态响应的所有限制值，以评估在装机条件下该仪表的适用性。\n\n**（b）使用说明**\n\n1. 中国民用航空局认定的使用限制；\n2. 功率或推力的额定值及在非标准大气条件下的修正程序；\n3. 在一般和极端环境条件下，对下列情况的荐用程序：\n   - 起动；\n   - 地面运转', n.section_number = '33.5', n.source = 'CCAR-33-R2', n.authority = 'CAAC', n.depth = 2;
MERGE (n:section {id: 'ccar33:0005'}) ON CREATE SET n.label = '第33.11条 适用范围', n.title = '第33.11条 适用范围', n.text = '本章规定航空活塞式和涡轮发动机的一般设计与构造要求。', n.section_number = '33.11', n.source = 'CCAR-33-R2', n.authority = 'CAAC', n.depth = 2;
MERGE (n:section {id: 'ccar33:0006'}) ON CREATE SET n.label = '第33.15条 材料 发动机所用材料的适用性和耐久性必须满足下列要求：', n.title = '第33.15条 材料 发动机所用材料的适用性和耐久性必须满足下列要求：', n.text = '发动机所用材料的适用性和耐久性必须满足下列要求：\n\n（a）建立在经验或试验的基础上；\n（b）符合经批准的规范（如工业或军用规范），保证这些材料具有设计资料中采用的强度和其他性能。', n.section_number = '33.15', n.source = 'CCAR-33-R2', n.authority = 'CAAC', n.depth = 2;
MERGE (n:section {id: 'ccar33:0007'}) ON CREATE SET n.label = '第33.17条 防火 （a） 发动机的设计和构造及所用的材料必须使着火和火焰蔓', n.title = '第33.17条 防火 （a） 发动机的设计和构造及所用的材料必须使着火和火焰蔓', n.text = '（a）发动机的设计和构造及所用的材料必须使着火和火焰蔓延的可能性减至最小。此外，涡轮发动机的设计和构造必须使出现导致结构失效、过热或其他危险状态的内部着火的可能性减至最小。\n\n（b）除（c）条规定外，在发动机正常工作期间存留或输送易燃液体的每一外部管路、接头和其他部件，必须由中国民用航空局确认是耐火的或是防火的。上述部件必须有防护或正确安装以防止点燃泄漏的易燃液体。\n\n（c）属于发动机部分并与发动机相连的易燃液体箱和支架必须是防火的或用防火罩防护，任一非防火的零部件被火烧坏后不会引起易燃液体泄漏或溅出则除外，活塞式发动机上容量小于23.7升（25夸脱）的整体湿油池，既不必是防火的，也不需用防火罩防护。\n\n（d）用于防火墙的发动机零件，其设计、构造和安装必须是：\n1. 防火的；\n2. 构造上不会使任何危险量的空气、液体或火焰绕过或穿过防火墙；\n3. 防腐蚀的。\n\n（e）除（a）和（b）条要求外，位于指定火区内的发动机控制系统部件必须由中国民用航空局确定是防火的或者耐火的。\n\n（f）必须通过排放和通风的方法防止发动机内易燃液体非故意的积聚达到危险量。\n\n（g）任何容易或者具有潜在产生静电放', n.section_number = '33.17', n.source = 'CCAR-33-R2', n.authority = 'CAAC', n.depth = 2;
MERGE (n:section {id: 'ccar33:0008'}) ON CREATE SET n.label = '第33.23条 发动机的安装构件和结构     （a） 必须规定发动机安装构件和相关的发动机结构的最大允', n.title = '第33.23条 发动机的安装构件和结构     （a） 必须规定发动机安装构件和相关的发动机结构的最大允', n.text = '发动机在附件传动装置和安装构件受载的情况下，必须能正常地运转。每一个发动机附件传动装置和安装构件必须具有密封措施以防止发动机内部的污染或来自发动机内部的不可接受的泄漏。要求用发动机滑油润滑外部传动花键或联轴节的传动装置和安装构件，必须采用密封措施以防止不可接受的滑油流失和防止来自封闭传动连接件腔室外的污染。发动机的设计必须能对发动机运转所需的每个附件进行检查、调整或更换。', n.section_number = '33.23', n.source = 'CCAR-33-R2', n.authority = 'CAAC', n.depth = 2;
MERGE (n:section {id: 'ccar33:0009'}) ON CREATE SET n.label = '第33.25条 附件连接装置', n.title = '第33.25条 附件连接装置', n.text = '第33.25条 附件连接装置\n\n- 发动机在附件传动装置和安装构件受载的情况下，必须能正常地运转\n- 每一个发动机附件传动装置和安装构件必须具有密封措施以防止：\n  - 发动机内部的污染\n  - 来自发动机内部的不可接受的泄漏\n  - 不可接受的滑油流失（外部传动花键或联轴节）\n  - 来自封闭传动连接件腔室外的污染\n- 发动机的设计必须能对发动机运转所需的每个附件进行检查、调整或更换\n\n---', n.section_number = '33.25', n.source = 'CCAR-33-R2', n.authority = 'CAAC', n.depth = 2;
MERGE (n:section {id: 'ccar33:0010'}) ON CREATE SET n.label = '第33.27条 涡轮、压气机、风扇和涡轮增压器转子', n.title = '第33.27条 涡轮、压气机、风扇和涡轮增压器转子', n.text = '（a）涡轮、压气机、风扇和涡轮增压器转子必须具有足够的强度以便能承受本条（c）款规定的试验条件。\n\n（b）除第33.28条要求之外的发动机系统、仪表和其它方法的设计和功能必须给予合理的保证，使影响涡轮、压气机、风扇和涡轮增压器转子结构完整性的发动机使用限制在使用中不会超出。\n\n**（c）超转试验要求**：根据分析或其他可接受的方法确定的每个涡轮、压气机和风扇中经受最关键应力的转子部件（除叶片外），其中包括发动机或涡轮增压器中的整体鼓筒转子和离心式压气机，必须在下列条件下试验5分钟：\n\n1. 除了本条（c）（2）（iv）的规定外，以其最大工作温度进行；\n2. 以下列适用的最高转速进行：\n   - 如果在试验台上试验并且转子部件装有叶片或叶片配重块，则以其最大允许转速的120%进行；\n   - 如果试验在发动机上进行，则以其最大允许转速的115%进行；\n   - 如果试验在涡轮增压器上进行，由一特制燃烧室试验台提供炽热燃气驱动，则以其最大允许转速115%进行；\n   - 以120%的某个转速进行，冷转时，转子部件承受的工作应力相当于最高工作温度和最大允许转速导致的应力；\n   - 以105', n.section_number = '33.27', n.source = 'CCAR-33-R2', n.authority = 'CAAC', n.depth = 2;
MERGE (n:section {id: 'ccar33:0011'}) ON CREATE SET n.label = '第33.28条 发动机控制系统', n.title = '第33.28条 发动机控制系统', n.text = '**（a）适用性**：本条款适用于任何发动机型号设计中控制、限制或监控发动机工作，和发动机持续适航所必需的系统或设备。\n\n**（b）验证**\n1. **功能方面**：申请人必须通过试验、分析或两者结合的方法证明发动机控制系统能以下列方式实现预期的功能：\n   - 在声明的飞行包线内变化的大气条件下，保持有关控制参数的选定值，使发动机工作在批准的使用限制之内；\n   - 在所有可能的系统输入和允许的发动机功率或推力需求下，必须符合第33.51条、第33.65条以及第33.73条，如适用的使用要求，除非已证实控制功能故障导致在预定的使用中发动机不能被放行；\n   - 在声明的发动机使用条件范围内，发动机的功率或推力调节应具有足够的灵敏度；\n   - 不产生不可接受的功率或推力振荡。\n\n2. **环境限制**：申请人必须表明，当符合第33.53条和第33.91条时，在声明的环境条件下，包括电磁干扰（EMI）、高强度辐射场（HIRF）和闪电条件，发动机控制系统功能不会受到有害影响。\n\n**（c）控制转换**：当故障或失效导致控制模式、通道或者从主系统到备份系统的转换时：\n1. 发动机不会超出任', n.section_number = '33.28', n.source = 'CCAR-33-R2', n.authority = 'CAAC', n.depth = 2;
MERGE (n:section {id: 'ccar33:0012'}) ON CREATE SET n.label = '第33.29条 仪表连接', n.title = '第33.29条 仪表连接', n.text = '（a）除非在结构上能防止错接仪表，否则，按航空器适航标准要求的动力装置仪表所设置的每个连接件或者为保证发动机工作符合任何发动机使用限制所必需的每个连接件，都必须作标记，以标明与相应的仪表一致。\n\n（b）每台涡轮发动机必须为指示转子系统不平衡的显示系统提供接头。\n\n（c）具有30秒一台发动机不工作（OEI）功率额定值和2分钟一台发动机不工作（OEI）功率额定值的旋翼航空器涡轮发动机必须有方法或措施：\n1. 当发动机处于30秒一台发动机不工作（OEI）和2分钟一台发动机不工作（OEI）功率状态及状态开始和该时间间隔结束时，应提示飞行员；\n2. 自动记录每次使用30秒OEI和2分钟OEI功率水平的次数和持续时间；\n3. 使用可靠的方法提示维修人员发动机已经使用30秒OEI或2分钟OEI功率水平，并且允许维修人员取回已记录的数据；\n4. 能够针对上述方法的正确操作进行日常检验。\n\n**（其余条款详见完整文档...）**\n\n---\n\n> **注：本文档为CCAR-33-R2完整版，包含A章至H章所有条款。由于篇幅限制，此处仅展示部分章节。完整内容已保存至系统中。**', n.section_number = '33.29', n.source = 'CCAR-33-R2', n.authority = 'CAAC', n.depth = 2;
MERGE (n:section {id: 'ccar33:0013'}) ON CREATE SET n.label = 'C章 设计与构造：', n.title = 'C章 设计与构造：', n.text = '', n.section_number = '', n.source = 'CCAR-33-R2', n.authority = 'CAAC', n.depth = 1;
MERGE (n:section {id: 'ccar33:0014'}) ON CREATE SET n.label = '第33.31条 适用范围', n.title = '第33.31条 适用范围', n.text = '第33.31条 适用范围\n\n本章规定活塞式航空发动机附加的设计与构造要求。\n\n---', n.section_number = '33.31', n.source = 'CCAR-33-R2', n.authority = 'CAAC', n.depth = 2;
MERGE (n:section {id: 'ccar33:0015'}) ON CREATE SET n.label = '第33.34条 涡轮增压器转子', n.title = '第33.34条 涡轮增压器转子', n.text = '第33.34条 涡轮增压器转子\n\n每个涡轮增压器机匣必须设计、构造成，当正常转速控制装置不工作时，可以包容**最高转速**下压气机或涡轮转子失效产生的碎片。\n\n---', n.section_number = '33.34', n.source = 'CCAR-33-R2', n.authority = 'CAAC', n.depth = 2;
MERGE (n:section {id: 'ccar33:0016'}) ON CREATE SET n.label = '第33.35条 燃油和进气系统', n.title = '第33.35条 燃油和进气系统', n.text = '第33.35条 燃油和进气系统', n.section_number = '33.35', n.source = 'CCAR-33-R2', n.authority = 'CAAC', n.depth = 2;
MERGE (n:section {id: 'ccar33:0017'}) ON CREATE SET n.label = '第33.37条 点火系统 火花点火发动机必须装有双点火系统，每个气缸至少有两只', n.title = '第33.37条 点火系统 火花点火发动机必须装有双点火系统，每个气缸至少有两只', n.text = '第33.37条 点火系统\n\n火花点火发动机必须装有**双点火系统**，每个气缸至少有**两只火花塞**，并具有电源分开的**两条独立电路**；或者装有在飞行中可靠性相当的点火系统。\n\n---', n.section_number = '33.37', n.source = 'CCAR-33-R2', n.authority = 'CAAC', n.depth = 2;
MERGE (n:section {id: 'ccar33:0018'}) ON CREATE SET n.label = '第33.39条 润滑系统', n.title = '第33.39条 润滑系统', n.text = '第33.39条 润滑系统', n.section_number = '33.39', n.source = 'CCAR-33-R2', n.authority = 'CAAC', n.depth = 2;
MERGE (n:section {id: 'ccar33:0019'}) ON CREATE SET n.label = 'D章 台架试验：活塞式航空发动机', n.title = 'D章 台架试验：活塞式航空发动机', n.text = '', n.section_number = '', n.source = 'CCAR-33-R2', n.authority = 'CAAC', n.depth = 1;
MERGE (n:section {id: 'ccar33:0020'}) ON CREATE SET n.label = '第33.41条 适用范围', n.title = '第33.41条 适用范围', n.text = '第33.41条 适用范围\n\n本章规定活塞式航空发动机的台架试验和检验。\n\n---', n.section_number = '33.41', n.source = 'CCAR-33-R2', n.authority = 'CAAC', n.depth = 2;
MERGE (n:section {id: 'ccar33:0021'}) ON CREATE SET n.label = '第33.42条 概述 在本章规定的每项持久试验前，不经装机即可确定其调整位', n.title = '第33.42条 概述 在本章规定的每项持久试验前，不经装机即可确定其调整位', n.text = '第33.42条 概述\n\n在本章规定的每项持久试验前，不经装机即可确定其调整位置和功能特性的每个部件，必须确定和记录其调整位置和功能特性。\n\n---', n.section_number = '33.42', n.source = 'CCAR-33-R2', n.authority = 'CAAC', n.depth = 2;
MERGE (n:section {id: 'ccar33:0022'}) ON CREATE SET n.label = '第33.43条 振动试验', n.title = '第33.43条 振动试验', n.text = '第33.43条 振动试验', n.section_number = '33.43', n.source = 'CCAR-33-R2', n.authority = 'CAAC', n.depth = 2;
MERGE (n:section {id: 'ccar33:0023'}) ON CREATE SET n.label = '第33.45条 校准试验 （a） 每型发动机必须进行为确定第 33.49条规定的有关持久', n.title = '第33.45条 校准试验 （a） 每型发动机必须进行为确定第 33.49条规定的有关持久', n.text = '第33.45条 校准试验', n.section_number = '33.45', n.source = 'CCAR-33-R2', n.authority = 'CAAC', n.depth = 2;
MERGE (n:section {id: 'ccar33:0024'}) ON CREATE SET n.label = '第33.47条 爆震试验', n.title = '第33.47条 爆震试验', n.text = '第33.47条 爆震试验\n\n每型发动机必须试验，以确定在其预定的整个工作状态范围内，发动机能工作而不会发生爆震。\n\n---', n.section_number = '33.47', n.source = 'CCAR-33-R2', n.authority = 'CAAC', n.depth = 2;
MERGE (n:section {id: 'ccar33:0025'}) ON CREATE SET n.label = '第33.51条 工作试验', n.title = '第33.51条 工作试验', n.text = '第33.51条 工作试验\n\n工作试验必须包括中国民用航空局认为必要的试验，以验证发动机的**回火特性、起动、慢车、加速、超转、螺旋桨功能和点火**及任何其他工作特性。\n\n如果发动机装有多速增压器传动装置，则设计与构造必须允许增压器的运转从低速比转向高速比，并且在增压器高转速比下与额定最大连续功率所具有的进气压力和转速调定值相对应的功率，必须在**5秒内**达到。\n\n---', n.section_number = '33.51', n.source = 'CCAR-33-R2', n.authority = 'CAAC', n.depth = 2;
MERGE (n:section {id: 'ccar33:0026'}) ON CREATE SET n.label = '第33.53条 发动机系统和部件试验 （a） 对于不能按第 33.49条持久试验方法进行充分验证的每', n.title = '第33.53条 发动机系统和部件试验 （a） 对于不能按第 33.49条持久试验方法进行充分验证的每', n.text = '第33.53条 发动机系统和部件试验', n.section_number = '33.53', n.source = 'CCAR-33-R2', n.authority = 'CAAC', n.depth = 2;
MERGE (n:section {id: 'ccar33:0027'}) ON CREATE SET n.label = '第33.55条 分解检查 在完成持久试验后，满足下列要求：', n.title = '第33.55条 分解检查 在完成持久试验后，满足下列要求：', n.text = '第33.55条 分解检查', n.section_number = '33.55', n.source = 'CCAR-33-R2', n.authority = 'CAAC', n.depth = 2;
MERGE (n:section {id: 'ccar33:0028'}) ON CREATE SET n.label = '第33.57条 台架试验的一般实施', n.title = '第33.57条 台架试验的一般实施', n.text = '第33.57条 台架试验的一般实施', n.section_number = '33.57', n.source = 'CCAR-33-R2', n.authority = 'CAAC', n.depth = 2;
MERGE (n:section {id: 'ccar33:0029'}) ON CREATE SET n.label = 'E章 设计与构造：', n.title = 'E章 设计与构造：', n.text = '', n.section_number = '', n.source = 'CCAR-33-R2', n.authority = 'CAAC', n.depth = 1;
MERGE (n:section {id: 'ccar33:0030'}) ON CREATE SET n.label = '第33.61条 适用范围 本章规定航空涡轮发动机附加的设计与构造要求。', n.title = '第33.61条 适用范围 本章规定航空涡轮发动机附加的设计与构造要求。', n.text = '第33.61条 适用范围\n\n本章规定航空涡轮发动机附加的设计与构造要求。\n\n---', n.section_number = '33.61', n.source = 'CCAR-33-R2', n.authority = 'CAAC', n.depth = 2;
MERGE (n:section {id: 'ccar33:0031'}) ON CREATE SET n.label = '第33.62条 应力分析 必须对每型涡轮发动机进行应力分析，表明每个涡轮发动机', n.title = '第33.62条 应力分析 必须对每型涡轮发动机进行应力分析，表明每个涡轮发动机', n.text = '第33.62条 应力分析\n\n必须对每型涡轮发动机进行应力分析，表明每个涡轮发动机转子、隔圈和转子轴的**设计安全裕度**。\n\n---', n.section_number = '33.62', n.source = 'CCAR-33-R2', n.authority = 'CAAC', n.depth = 2;
MERGE (n:section {id: 'ccar33:0032'}) ON CREATE SET n.label = '第33.63条 振动', n.title = '第33.63条 振动', n.text = '第33.63条 振动\n\n每型发动机的设计和构造必须使发动机在其声明的整个飞行包线和整个转速和功率或推力的工作范围内正常工作，而不应导致因振动而使发动机的任何零部件应力过大，并且也不应导致将过大的振动力传给航空器结构。\n\n---', n.section_number = '33.63', n.source = 'CCAR-33-R2', n.authority = 'CAAC', n.depth = 2;
MERGE (n:section {id: 'ccar33:0033'}) ON CREATE SET n.label = '第33.65条 喘振和失速特性 发动机按第 33.5 条（b）规定的使用说明运转时，即在发动', n.title = '第33.65条 喘振和失速特性 发动机按第 33.5 条（b）规定的使用说明运转时，即在发动', n.text = '第33.65条 喘振和失速特性\n\n发动机按第33.5条（b）规定的使用说明运转时，即在发动机工作包线内的任何一点上：\n\n- 起动、功率或推力的变化、功率的增大或推力的加力\n- **极限的进气畸变**或进气温度\n\n**不得引起喘振或失速**达到出现以下情况的程度：\n1. 熄火\n2. 结构失效\n3. 超温\n4. 发动机功率或推力不能恢复\n\n---', n.section_number = '33.65', n.source = 'CCAR-33-R2', n.authority = 'CAAC', n.depth = 2;
MERGE (n:section {id: 'ccar33:0034'}) ON CREATE SET n.label = '第33.66条 引气系统', n.title = '第33.66条 引气系统', n.text = '第33.66条 引气系统\n\n在第33.7条（c）（11）中规定的极限引气状态的所有条件下，发动机必须提供引气而不会对发动机产生**除推力或功率输出降低外**的不利影响。\n\n如果能控制发动机防冰的引气，则必须设置指示发动机防冰系统功能的装置。\n\n---', n.section_number = '33.66', n.source = 'CCAR-33-R2', n.authority = 'CAAC', n.depth = 2;
MERGE (n:section {id: 'ccar33:0035'}) ON CREATE SET n.label = '第33.67条 燃油系统 （a） 在按申请人规定的流量和压力对发动机供给燃油的情况', n.title = '第33.67条 燃油系统 （a） 在按申请人规定的流量和压力对发动机供给燃油的情况', n.text = '第33.67条 燃油系统', n.section_number = '33.67', n.source = 'CCAR-33-R2', n.authority = 'CAAC', n.depth = 2;
MERGE (n:section {id: 'ccar33:0036'}) ON CREATE SET n.label = '第33.69条 点火系统', n.title = '第33.69条 点火系统', n.text = '第33.69条 点火系统\n\n每型发动机必须安装有地面和飞行中起动发动机的点火系统。\n\n- 除了燃油加力燃烧系统只要求一个点火器外\n- 电点火系统必须至少有**二个点火器和二条独立的次级电路**\n\n---', n.section_number = '33.69', n.source = 'CCAR-33-R2', n.authority = 'CAAC', n.depth = 2;
MERGE (n:section {id: 'ccar33:0037'}) ON CREATE SET n.label = '第33.70条 发动机限寿件', n.title = '第33.70条 发动机限寿件', n.text = '第33.70条 发动机限寿件\n\n必须通过中国民用航空局批准的程序，指定使用限制中发动机每个限寿件的**最大允许飞行循环数**。', n.section_number = '33.70', n.source = 'CCAR-33-R2', n.authority = 'CAAC', n.depth = 2;
MERGE (n:section {id: 'ccar33:0038'}) ON CREATE SET n.label = '第33.71条 润滑系统', n.title = '第33.71条 润滑系统', n.text = '第33.71条 润滑系统', n.section_number = '33.71', n.source = 'CCAR-33-R2', n.authority = 'CAAC', n.depth = 2;
MERGE (n:section {id: 'ccar33:0039'}) ON CREATE SET n.label = '第33.73条 功率或推力响应', n.title = '第33.73条 功率或推力响应', n.text = '第33.73条 功率或推力响应', n.section_number = '33.73', n.source = 'CCAR-33-R2', n.authority = 'CAAC', n.depth = 2;
MERGE (n:section {id: 'ccar33:0040'}) ON CREATE SET n.label = '第33.74条 持续转动', n.title = '第33.74条 持续转动', n.text = '第33.74条 持续转动\n\n由于飞行中的任何原因使发动机停车，如果停车后发动机的任何主转动系统仍持续转动并且没有提供阻止持续转动的装置，那么在最长的飞行周期内和在预期该发动机不工作的飞行条件下，任何持续的转动不得导致：\n1. 非包容的高能碎片\n2. 客舱用发动机引气中有毒物质浓度足以使机组人员或乘客失去能力\n3. 与驾驶员命令的推力方向相反的较大的推力\n4. 不可控火情\n5. 发动机安装系统失效，导致非故意的发动机脱开\n6. 发动机引起的螺旋桨脱开\n7. 完全失去发动机停车能力\n\n---', n.section_number = '33.74', n.source = 'CCAR-33-R2', n.authority = 'CAAC', n.depth = 2;
MERGE (n:section {id: 'ccar33:0041'}) ON CREATE SET n.label = '第33.75条 安全分析', n.title = '第33.75条 安全分析', n.text = '(a) (1)为了评估预期可能发生的所有失效的后果，申请人必\n(i) 与典型发动机安装相关的飞机级装置和程序假设，在分\n(b) 中国民用航空局可以要求通过试验对任何有关失效和可\n(c) 某些单个元件的主要失效不能用数字合理地估计。如果\n(d) 如果依靠安全系统以防止失效发展到导致危害性发动机\n(e) 如果安全分析取决于下述一项或多项，则必须在分析中\n(f) 如果适用， 安全分析必须包括，但不限于以下项目的检查：\n(g) 除了另有中国民用航空局批准并在安全分析中已声明的\n(i) 非包容的高能碎片；\n(v) 发动机安装系统失效，导致非故意的发动机脱开； (vi) 如果适用，发动机引起的螺旋桨脱开；', n.section_number = '33.75', n.source = 'CCAR-33-R2', n.authority = 'CAAC', n.depth = 2;
MERGE (n:section {id: 'ccar33:0042'}) ON CREATE SET n.label = '第33.77条 外物吸入一冰', n.title = '第33.77条 外物吸入一冰', n.text = '第33.77条 外物吸入—冰', n.section_number = '33.77', n.source = 'CCAR-33-R2', n.authority = 'CAAC', n.depth = 2;
MERGE (n:section {id: 'ccar33:0043'}) ON CREATE SET n.label = 'F章 台架试验：航空涡轮发动机', n.title = 'F章 台架试验：航空涡轮发动机', n.text = '', n.section_number = '', n.source = 'CCAR-33-R2', n.authority = 'CAAC', n.depth = 1;
MERGE (n:section {id: 'ccar33:0044'}) ON CREATE SET n.label = '第33.81条 适用范围 本章规定涡轮发动机的台架试验和检验。 第 33.82条  概述', n.title = '第33.81条 适用范围 本章规定涡轮发动机的台架试验和检验。 第 33.82条  概述', n.text = '第33.81条 适用范围\n\n本章规定涡轮发动机的台架试验和检验。\n\n---', n.section_number = '33.81', n.source = 'CCAR-33-R2', n.authority = 'CAAC', n.depth = 2;
MERGE (n:section {id: 'ccar33:0045'}) ON CREATE SET n.label = '第33.83条 振动试验 （a）每型发动机必须进行振动测试，以确定可能受机械或空', n.title = '第33.83条 振动试验 （a）每型发动机必须进行振动测试，以确定可能受机械或空', n.text = '第33.83条 振动试验', n.section_number = '33.83', n.source = 'CCAR-33-R2', n.authority = 'CAAC', n.depth = 2;
MERGE (n:section {id: 'ccar33:0046'}) ON CREATE SET n.label = '第33.84条 发动机超扭试验', n.title = '第33.84条 发动机超扭试验', n.text = '(a) 对带有自由涡轮的发动机，如果申请获得最大发动机超\n(b) 试验条件必须满足：', n.section_number = '33.84', n.source = 'CCAR-33-R2', n.authority = 'CAAC', n.depth = 2;
MERGE (n:section {id: 'ccar33:0047'}) ON CREATE SET n.label = '第33.85条 校准试验', n.title = '第33.85条 校准试验', n.text = '第33.85条 校准试验', n.section_number = '33.85', n.source = 'CCAR-33-R2', n.authority = 'CAAC', n.depth = 2;
MERGE (n:section {id: 'ccar33:0048'}) ON CREATE SET n.label = '第33.88条 发动机超温试验', n.title = '第33.88条 发动机超温试验', n.text = '第33.88条 发动机超温试验', n.section_number = '33.88', n.source = 'CCAR-33-R2', n.authority = 'CAAC', n.depth = 2;
MERGE (n:section {id: 'ccar33:0049'}) ON CREATE SET n.label = '第33.89条 工作试验', n.title = '第33.89条 工作试验', n.text = '第33.89条 工作试验', n.section_number = '33.89', n.source = 'CCAR-33-R2', n.authority = 'CAAC', n.depth = 2;
MERGE (n:section {id: 'ccar33:0050'}) ON CREATE SET n.label = '第33.90条 初始维修检查', n.title = '第33.90条 初始维修检查', n.text = '第33.90条 初始维修检查\n\n申请人必须在基本符合最终型号设计的发动机上完成下列一项试验，以确定要求初次维修检查的时限：\n1. 批准的发动机运转试验，该试验模拟使用中所预期的发动机工作状态\n2. 按照第33.201条（c）至（f）要求进行批准的发动机运转试验\n\n---', n.section_number = '33.90', n.source = 'CCAR-33-R2', n.authority = 'CAAC', n.depth = 2;
MERGE (n:section {id: 'ccar33:0051'}) ON CREATE SET n.label = '第33.92条 转子锁定试验', n.title = '第33.92条 转子锁定试验', n.text = '第33.92条 转子锁定试验\n\n如果采用锁定转子装置以阻止发动机持续转动，则发动机必须在以下条件下进行包括该装置工作**25次**的试验：\n1. 发动机必须从额定最大连续推力或功率状态停车\n2. 必须在承受在该状态下持续飞行可能引起的最大扭矩的情况下，按发动机使用说明的规定操作停止和锁定转子的装置\n3. 在25次工作中，每一次转子锁定后，转子必须在这些状态下保持静止**5分钟**\n\n---', n.section_number = '33.92', n.source = 'CCAR-33-R2', n.authority = 'CAAC', n.depth = 2;
MERGE (n:section {id: 'ccar33:0052'}) ON CREATE SET n.label = '第33.93条 分解检查', n.title = '第33.93条 分解检查', n.text = '第33.93条 分解检查', n.section_number = '33.93', n.source = 'CCAR-33-R2', n.authority = 'CAAC', n.depth = 2;
MERGE (n:section {id: 'ccar33:0053'}) ON CREATE SET n.label = '第33.94条 叶片包容性和转子不平衡试验 （a）除了本条（b）款规定外，除非在下列每一事故后发动', n.title = '第33.94条 叶片包容性和转子不平衡试验 （a）除了本条（b）款规定外，除非在下列每一事故后发动', n.text = '第33.94条 叶片包容性和转子不平衡试验', n.section_number = '33.94', n.source = 'CCAR-33-R2', n.authority = 'CAAC', n.depth = 2;
MERGE (n:section {id: 'ccar33:0054'}) ON CREATE SET n.label = '第33.96条 以辅助动力装置（APU）方式工作的发动机试验', n.title = '第33.96条 以辅助动力装置（APU）方式工作的发动机试验', n.text = '第33.96条 以辅助动力装置（APU）方式工作的发动机试验\n\n如果发动机设计成带螺旋桨制动器，那么除了第33.87条的要求外，申请人必须做下列试验：\n1. 地面锁定：螺旋桨制动器以某种方式耦合共**45小时**\n2. 动态制动：制动器必须以某种方式进行共**400个使用—放松耦合的循环**\n3. 螺旋桨制动器耦合时，进行**100次发动机起动和停车**\n4. 必须在完成试验后，将发动机分解到为表明符合第33.93所必需的程度\n\n---', n.section_number = '33.96', n.source = 'CCAR-33-R2', n.authority = 'CAAC', n.depth = 2;
MERGE (n:section {id: 'ccar33:0055'}) ON CREATE SET n.label = '第33.97条 反推力装置 （a） 如果发动机装有反推力装置， 则本章规定的持久、 校准、', n.title = '第33.97条 反推力装置 （a） 如果发动机装有反推力装置， 则本章规定的持久、 校准、', n.text = '第33.97条 反推力装置', n.section_number = '33.97', n.source = 'CCAR-33-R2', n.authority = 'CAAC', n.depth = 2;
MERGE (n:section {id: 'ccar33:0056'}) ON CREATE SET n.label = 'G章 专用要求  航空涡轮发动机', n.title = 'G章 专用要求  航空涡轮发动机', n.text = '', n.section_number = '', n.source = 'CCAR-33-R2', n.authority = 'CAAC', n.depth = 1;
MERGE (n:section {id: 'ccar33:0057'}) ON CREATE SET n.label = '第33.201条 早期 ETOPS资格的设计和试验要求', n.title = '第33.201条 早期 ETOPS资格的设计和试验要求', n.text = '第33.201条 早期ETOPS资格的设计和试验要求\n\n如果申请人在没有25部附录K中规定的使用经验的情况下，对于安装在批准用于ETOPS运行的双发飞机上的发动机，如要获得发动机型号设计批准，则必须符合下列要求：\n\n---', n.section_number = '33.201', n.source = 'CCAR-33-R2', n.authority = 'CAAC', n.depth = 2;
