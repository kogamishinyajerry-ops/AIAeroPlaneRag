# Zhipu GLM API Key (Primary LLM)
ZHIPU_API_KEY="your_zhipu_api_key_here"

# OpenAI API Key (Optional, used for OpenAI embeddings if enabled)
OPENAI_API_KEY="your_openai_api_key_here"

# LlamaCloud API Key for LlamaParse (High-fidelity document parsing)
LLAMA_CLOUD_API_KEY="your_llama_cloud_api_key_here"

# Neo4j Graph Database (For Ontology & GraphRAG)
NEO4J_URI="bolt://localhost:7687"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD="password"

# Local Vector DB path
CHROMA_DB_DIR="./data/processed/chroma_db"

# Application mode: mock / real
APP_MODE="mock"

# Application / prompt / retrieval version labels
APP_VERSION="0.1.0"

# Knowledge base / document version label returned in API responses
DOCUMENT_VERSION="ccar33-enriched-mock-v1"
PROMPT_VERSION="rag-prompt-v1"
EMBEDDING_VERSION="simple-hash-v1"
GRAPH_VERSION="ccar33-graph-export-v1"
